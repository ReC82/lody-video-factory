# Configuration du broker de fusion LODYORCH (#207) — installée dans /etc/lodyorch/merge-broker.env
# (root:lodyorch-merge, 0640), JAMAIS écrasée par install.sh. Aucun secret ici : les secrets sont
# dans des fichiers séparés, lisibles du seul broker (voir docs/lody-isolation-permissions.md).
#
# Toute modification de ce fichier RÉARME le mode réel : une autorisation `merge:auto` posée avant
# la date de modification ne vaut rien (non-rétroactivité impossible à contourner par une session).
LQ_REPO=ReC82/lody-video-factory
# PLAFOND ROOT de la fusion automatique : off | dry-run | on. Kill switch matériel :
#   sudo sed -i 's/^LQ_AUTO_MERGE=.*/LQ_AUTO_MERGE=off/' /etc/lodyorch/merge-broker.env
LQ_AUTO_MERGE=dry-run
# Comptes HUMAINS dont le label `merge:auto` vaut autorisation (jamais un compte [bot]).
LQ_MERGE_TRUSTED=ReC82
# Auteurs de PR acceptés : le propriétaire et l'application des sessions (remplacer le slug).
LQ_MERGE_PR_AUTHORS=ReC82,lody-agent-rec82[bot]
# Application GitHub des sessions (identifiants numériques, non secrets).
LQ_APP_ID=
LQ_APP_INSTALLATION_ID=
# Secrets (fichiers root:lodyorch-merge 0640) et dossiers du broker.
LQ_APP_KEY_FILE=/etc/lodyorch/app-key.pem
LQ_BROKER_TOKEN_FILE=/etc/lodyorch/merge-token
LQ_BROKER_DIR=/var/lib/lodyorch-merge
LQ_AGENT_TOKEN_FILE=/var/lib/lodyorch-merge/agent/token
