[Unit]
Description=Lody Video Factory — superviseur des sessions Claude (LODYORCH, sans fenêtre ; console = tmux lodyorch)
After=network-online.target
Wants=network-online.target
# Pas de boucle de relance : au plus 5 redémarrages par heure, puis systemd abandonne.
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
# Compte de service des autres superviseurs : jamais root.
User=ubuntu
Environment=HOME=/home/ubuntu
# /opt/lodyorch/bin en tête : gh et l'assistant Git y utilisent le jeton de l'application GitHub
# (#207), jamais celui du propriétaire.
Environment=PATH=/opt/lodyorch/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/lodyorch/lodyorch.env
WorkingDirectory=/home/ubuntu/lody-orch
ExecStart=/usr/bin/python3 /opt/lodyorch/lodyorch.py run
# Relancé seulement après un plantage. Après « lodyorch stop », refuse de retravailler avant « lodyorch resume ».
Restart=on-failure
RestartSec=120
# « systemctl stop » arrête aussi la session Claude en cours (préférer « lodyorch stop »).
KillMode=control-group
TimeoutStopSec=90
# Isolation imposée par le noyau au superviseur ET à ses sessions Claude (héritée) :
# - NoNewPrivileges : sudo et tout binaire setuid deviennent inopérants (donc ni docker, ni
#   systemctl, ni changement de compte) ;
# - l'arbre de production Lody (config.toml et ses sauvegardes, secrets/, storage/, data/) et les
#   fichiers SMTP/clés des autres projets sont invisibles ;
# - les autres projets et superviseurs sont en lecture seule (leurs bases d'état restent lisibles
#   pour le quota partagé), le système (/usr, /etc, /boot) aussi ;
# - #207 : secrets et journal du broker de fusion (utilisateur lodyorch-merge) invisibles, ainsi que
#   les sockets qui donnent root sans sudo (Docker, containerd, LXD : ubuntu est membre du groupe lxd).
NoNewPrivileges=yes
ProtectSystem=full
InaccessiblePaths=-/srv/moneyprinterturbo -/home/ubuntu/.config/plugadmin -/home/ubuntu/.config/dig -/home/ubuntu/.ssh -/etc/dig -/etc/lodyorch -/var/lib/lodyorch-merge/state -/run/docker.sock -/var/run/docker.sock -/run/containerd -/var/snap/lxd -/run/lxd.socket
ReadOnlyPaths=-/srv -/opt -/home/ubuntu/Dig -/home/ubuntu/LodyLand -/home/ubuntu/.local/state
ReadWritePaths=/home/ubuntu/.local/state/lodyorch -/home/ubuntu/.local/state/claude -/var/lib/lodyorch-merge/requests
PrivateTmp=yes
# Ressources : l'hôte (2 CPU, ~4 Go) est partagé avec la production Lody. Les sessions (Claude, tests,
# rendus Remotion/Chrome) sont freinées au-delà de 1,4 Go et ne dépassent jamais 1,8 Go ni 1,5 CPU ;
# poids CPU/disque réduits pour laisser la priorité aux conteneurs de production.
MemoryHigh=1400M
MemoryMax=1800M
CPUQuota=150%
CPUWeight=50
IOWeight=50

[Install]
WantedBy=multi-user.target
