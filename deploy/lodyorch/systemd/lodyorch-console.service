[Unit]
Description=Lody Video Factory — console tmux de supervision LODYORCH (tmux attach -t lodyorch)
After=lodyorch.service

[Service]
Type=forking
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
# Console d'observation uniquement : le superviseur tourne dans lodyorch.service.
# Refuse de démarrer si une autre session tmux s'appelle déjà « lodyorch » (jamais tuée).
ExecStart=/opt/lodyorch/console.sh start
ExecStop=/opt/lodyorch/console.sh stop
RemainAfterExit=yes
Restart=no

[Install]
WantedBy=multi-user.target
