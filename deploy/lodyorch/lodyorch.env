# Instance LODYORCH du superviseur (code issu de DIGORCH /opt/dig-orch, voir docs/lodyorch.md).
# Lu par lodyorch.service et par la commande /usr/local/bin/lodyorch. Aucun secret ici.
LQ_STATE_DIR=/home/ubuntu/.local/state/lodyorch
LQ_REPO=ReC82/lody-video-factory
# Clone DÉDIÉ (jamais /srv/moneyprinterturbo, qui contient config.toml, secrets/ et le stockage
# du moteur en production). Les sessions y démarrent et créent leurs worktrees à côté.
LQ_LAUNCH_DIR=/home/ubuntu/lody-orch/repo
LQ_WORKDIR=/home/ubuntu/lody-orch/worktrees
LQ_PROMPT=/opt/lodyorch/session_prompt.md
LQ_CLAUDE=/home/ubuntu/.local/bin/claude
# Crochet de garde et refus imposés à chaque session ; aucun connecteur MCP.
LQ_CLAUDE_SETTINGS=/opt/lodyorch/claude-settings.json
LQ_STRICT_MCP=1
LQ_REQUIRE_AUTH=1
ENABLE_CLAUDEAI_MCP_SERVERS=false
LQ_SERVICE=lodyorch
LQ_CLI=lodyorch
LQ_INSTANCE=LODYORCH
LQ_BOT_MARKER="<!-- lodyorch -->"
LQ_TRIAGE=0
LQ_SESSION_ENQUEUE=0
# File = tickets GitHub ouverts portant agent:auto, triés priority:P0 → P3 (P2 sans label valide).
LQ_GH_SYNC=1
LQ_SYNC_EVERY=600
LQ_ELIGIBLE_LABEL=agent:auto
LQ_HOLD_LABELS=agent:human
LQ_DEFAULT_PRIORITY=2
# Labels tenus par le superviseur : en cours / bloqué / livré (PR en attente de revue).
LQ_STATUS_LABELS='{"RUNNING": "agent:in-progress", "BLOCKED": "agent:blocked", "FAILED": "agent:blocked", "WAITING_OWNER": "status:needs-test", "DONE": "status:needs-test"}'
LQ_WAITING_TEXT="PR ouverte, en attente de revue et de fusion par le propriétaire (aucun déploiement)"
# Une dépendance n'est levée que par un ticket fermé (PR fusionnée) ou DONE : jamais par une PR en attente.
LQ_DEPS_DONE_STATES=DONE
# Protocole #117 : référentiel des labels, prise en charge publiée une fois, livraison = PR obligatoire.
LQ_LABELS_FILE=/opt/lodyorch/labels.json
LQ_CLAIM_COMMENT=1
LQ_REQUIRE_PR=1
# CI suivie par le superviseur (aucune session Claude n'attend) : interrogation toutes les 5 min,
# 2 corrections au plus, blocage si aucune conclusion après 3 h.
LQ_CI_WATCH=1
LQ_CI_POLL=300
LQ_CI_MAX_FIXES=2
LQ_CI_TIMEOUT=10800
LQ_DAY_TZ=Europe/Brussels
# Quota Claude partagé avec les autres superviseurs : leurs bases sont lues en lecture seule.
LQ_SHARED_USAGE_DBS=/home/ubuntu/.local/state/dig-orch/state.db,/home/ubuntu/.local/state/lodyquests-orch/state.db,/home/ubuntu/.local/state/jury-central-orch/state.db
# Plafonds prudents au démarrage (à relever par le propriétaire après les premières sessions).
LQ_MAX_SESSIONS_PER_DAY=8
LQ_MAX_FIVE_HOUR_UTILIZATION=0.8
LQ_MAX_SEVEN_DAY_UTILIZATION=0.7
LQ_MAX_ATTEMPTS=3
LQ_SESSION_MAX=7200
LQ_SESSION_IDLE=3600
# Environnement Python partagé par les worktrees (uv sync --frozen), pour ne pas multiplier les .venv.
UV_PROJECT_ENVIRONMENT=/home/ubuntu/lody-orch/venv
# Console : LA session tmux interactive du propriétaire (Claude dans le dépôt), comme dig et
# rpgquest. Le service ne crée aucune fenêtre ; il travaille en arrière-plan et cède la main dès
# que le propriétaire écrit (crochets de .claude/settings.local.json, voir console_settings.py).
LQ_TMUX_SESSION=lodyorch
LQ_CONSOLE_DIR=/srv/moneyprinterturbo
LQ_HUMAN_QUIET=900
LQ_YIELD_GRACE=300
# « lodyorch status » (lecture seule) : unité systemd affichée.
LQ_STATUS_UNITS=lodyorch.service
# Rapport permanent par tentative (#123) : archivé dans $LQ_STATE_DIR/reports/runs, publié en
# commentaire du ticket (lien permanent), puis envoyé par email avec le Markdown en pièce jointe.
LQ_RUN_REPORTS=1
LQ_REPORT_PROJECT="Lody Video Factory"
# Emails : fichier SMTP existant de PlugAdmin (même transport et même destinataire que digorch et
# jury-central). Invisible pour le superviseur et ses sessions Claude : seule l'unité
# lodyorch-notify (timer) le lit, sans jamais le copier ni l'afficher.
LQ_NOTIFY_SMTP_ENV=/home/ubuntu/.config/plugadmin/smtp.env
LQ_NOTIFY_PREFIX="[Lody Video Factory]"
