[Unit]
Description=Applique les clés en attente de Lody Video Factory dans config.toml (avec retour arrière automatique)
# Ne se déclenche que via lody-secrets-reload.path ; à la main pour diagnostiquer : systemctl start lody-secrets-reload.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/moneyprinterturbo
ExecStart=/srv/moneyprinterturbo/scripts/lody-apply-secrets.sh
# Aucune valeur de secret ne doit jamais transiter par les journaux : le script n'en écrit aucune (voir
# webui/lody/generation/apply_secrets.py). Niveau de journalisation standard, rien de spécial à filtrer ici.
