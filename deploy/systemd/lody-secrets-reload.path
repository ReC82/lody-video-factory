[Unit]
Description=Surveille les clés en attente de Lody Video Factory (secrets/secrets.reload)

[Path]
# Un seul fichier signal surveillé, jamais secrets.toml lui-même : cette unité n'a pas besoin de savoir
# qu'une clé a changé, seulement qu'une application est demandée.
# Fiabilité du déclenchement sur un remplacement atomique (os.replace) vérifiée empiriquement sur l'hôte de
# production (3 remplacements consécutifs + le cas « fichier jamais créé avant » : les trois ont déclenché le
# service en moins d'une seconde) — voir docs/lody-secrets.md.
PathModified=/srv/moneyprinterturbo/secrets/secrets.reload

[Install]
WantedBy=multi-user.target
