# Contexte de build de Dockerfile.lody : jamais de secret ni de données.
.git
.github
.gitignore
config.toml
config.toml.rollback
secrets
storage
data
**/__pycache__
**/*.pyc
.env
.env.*
docs
README*.md
uv.lock
