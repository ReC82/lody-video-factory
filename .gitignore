.DS_Store
/config.toml
/config.toml.bak
/config.toml.bak*
/config.toml.rollback
# N'importe quelle sauvegarde de config.toml, quel que soit son suffixe (ex. une sauvegarde manuelle avant de
# changer une clé) : jamais suivie par Git, même si son nom ne correspond pas aux motifs ci-dessus.
/config.toml.*
/secrets/
/storage/
/engine-report/
/.idea/
/app/services/__pycache__
/app/__pycache__/
/app/config/__pycache__/
/app/models/__pycache__/
/app/utils/__pycache__/
/*/__pycache__/*
.vscode
/**/.streamlit
__pycache__
logs/

node_modules
# VuePress 默认临时文件目录
/sites/docs/.vuepress/.temp
# VuePress 默认缓存目录
/sites/docs/.vuepress/.cache
# VuePress 默认构建生成的静态文件目录
/sites/docs/.vuepress/dist
# 模型目录
/models/
./models/*

venv/
.venv

# Debug and test files
CLAUDE.md
debug/
debug_*.py
test_*.py
!test/services/test_*.py
!test/test_*.py
!test/lody/test_*.py
streamlit.log
.coverage
coverage.xml
htmlcov/
.codegraph
/docs/superpowers
.understand-anything

